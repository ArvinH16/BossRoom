# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bossroom

# Server
PORT=8080
LOG_LEVEL=DEBUG
ALLOWED_ORIGIN=*

# Frontend WebSocket URL
# Local dev: ws://localhost:8080
# Production: wss://your-backend-url.run.app
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Server)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Optional: Composio for agent tools
COMPOSIO_API_KEY=

# ========================================
# CLOUDFLARE PAGES DEPLOYMENT INSTRUCTIONS
# ========================================
#
# In Cloudflare Pages dashboard, set these environment variables:
#
# Required:
# - NEXT_PUBLIC_WS_URL=wss://your-backend-url.run.app
# - NEXT_PUBLIC_FIREBASE_API_KEY=...
# - NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=...
# - NEXT_PUBLIC_FIREBASE_PROJECT_ID=...
# - NEXT_PUBLIC_FIREBASE_APP_ID=...
#
# In Cloud Run (backend), set:
# - ALLOWED_ORIGIN=https://bossroom.pages.dev
#
# Note: Use wss:// (not ws://) for production WebSocket connections
